{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simgamerjen-website",
  "compatibility_date": "2026-08-16",
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/download/*"]
  },
  "d1_databases": [
    {
      "binding": "DOWNLOAD_STATS"
    }
  ]
}
